# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored and should never be committed.
#
# Find these in your Supabase project dashboard:
# Project Settings > API > Project URL / Project API keys > anon public

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Maps JavaScript API key, used to render the map pin on a
# property's detail page. Get one from https://console.cloud.google.com/
# (enable the "Maps JavaScript API"). Never commit a real key — this file
# is just the template; your real key goes in .env.local, which is
# git-ignored. Without this set, the detail page falls back to a plain
# "Open in Google Maps" link instead of an embedded map.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
